#region OptionalUnigores
## Note: Comment the next line if you want to checkin your web deploy settings, but database connection strings (with potential passwords) will be unencrypted
*.pubxml
## Comment the next line if you want to checkin your Azure Web App publish settings, but sensitive information contained in these scripts will be unencrypted.
PublishScripts/
#endregion



#region OptionalIgnores
## Uncomment if you have tasks that create the project's static files in wwwroot
#wwwroot/
## Uncomment if necessary however generally it will be regenerated when needed
#!**/[Pp]ackages/repositories.config
## Since there are multiple workflows, uncomment next line to ignore bower_components (https://github.com/github/gitignore/pull/1529#issuecomment-104372622)
#bower_components/
## Uncomment if you are using Cake tools
#tools/**
#!tools/packages.config
#endregion



#region Exceptions
## Directory.Build.rsp configures directory-level build defaults
!Directory.Build.rsp
!.axoCover/settings.json
## Used as an MSBuild target.
!**/[Pp]ackages/build/
## Track directories ending in .cache
!?*.[Cc]ache/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
#endregion